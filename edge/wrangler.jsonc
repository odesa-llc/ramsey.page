{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ramsey-portfolio-agent-readiness",
  "main": "agent-readiness.mjs",
  "compatibility_date": "2026-11-09",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {"pattern": "ramsey.page/*", "zone_name": "ramsey.page"}
  ],
  "vars": {"BASE_PATH": "/"}
}
